    <div class="miga">
        <a href="/">Inicio</a>
        <p>></p>
        <a href="/cursos">Cursos</a>
    </div>

    <main class="main-cursos">
        <h1>Cursos</h1>
        
        <div class="listaCursos"></div>

        
        <aside>
            <h3>Panel de gestión</h3>
            <form id="buscar">
                <div class="input-group">
                    <label class="input-group-text fw-bold" for="name">Nombre:</label>
                    <input class="form-control" type="text" name="name" id="name" placeholder="Nombre del curso" required>
                </div>

                <input class="btn btn-success fw-bold" type="submit" value="Buscar cursos">
            </form>

            <div class="buttons">
                <button class="btn btn-primary fw-bold" id="btn_reiniciar">Reinciar filtro</button>
            </div>
        </aside>
    </main>
    
    
    <%- include('./partials/footer') %>

    <script>
        const cursos = <%- JSON.stringify(cursos) %> ;
    </script>
</body>


</html>
