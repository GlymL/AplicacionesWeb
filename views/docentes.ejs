<html lang="es">

<%- include('./partials/head') %>

<body>
    <%- include('./partials/nav') %>

    <div class="miga">
        <a href="/">Inicio</a>
        <p>></p>
        <a href="/docentes">Docentes</a>
    </div>

    <main>
        <h1>Docentes</h1>

        <div class="listaDocentes"></div>

        <aside>
            <h3>Panel de gestión</h3>
            <form id="buscar" action="/docentes/buscar" method="GET">
                <div class="input-group">
                    <label class="input-group-text fw-bold" for="name">Nombre:</label>
                    <input class="form-control" type="text" name="name" id="name" placeholder="Nombre del docente" required>
                </div>

                <input class="btn btn-success fw-bold" type="submit" value="Buscar docente">
            </form>

            <div class="buttons">
                <button class="btn btn-primary fw-bold" id="btn_reiniciar">Reinciar filtro</button>
            </div>
        </aside>
    </main>

    <%- include('./partials/footer') %>

    <script>
        const docentes = <%- JSON.stringify(docentes) %> ;
    </script>
</body>
</html>